 src/p_setup.c  |  4 ++++
 src/p_tick.c   |  2 ++
 src/params.h   | 23 +++++++++++++++++++++++
 src/r_defs.h   |  5 +++++
 src/r_things.c | 16 ++++++++++++++++
 14 files changed, 101 insertions(+), 3 deletions(-)


+          ps_col_drawn = true;
           dc_source = (byte *) column + 3;
           dc_texturemid = basetexturemid - (top<<FRACBITS);
 
@@ -475,6 +480,8 @@ void R_DrawVisSprite(vissprite_t *vis, int x1, int x2)
   frac = vis->startfrac;
   spryscale = vis->scale;
   sprtopscreen = centeryfrac - FixedMul(dc_texturemid,spryscale);
+  ps_col_drawn = false;
+  ps_col_top = viewheight;
 
   for (dc_x=vis->x1 ; dc_x<=vis->x2 ; dc_x++, frac += vis->xiscale)
     {
@@ -489,6 +496,11 @@ void R_DrawVisSprite(vissprite_t *vis, int x1, int x2)
                             LONG(patch->columnofs[texturecolumn]));
       R_DrawMaskedColumn (column);
     }
+
+  // psdoom-plus: psDooM's floating "pid / name" label
+  if (vis->ps_draw && ps_col_drawn)
+    PS_DrawLabel(vis->ps_pid, vis->ps_label, vis->x1, vis->x2,
+                 ps_col_top, vis->scale);
   colfunc = R_DrawColumn;         // killough 3/14/98
 }
 
@@ -680,6 +692,9 @@ static void R_ProjectSprite(mobj_t* thing, int lightlevel_override)
   vis->voxel_index = -1;
 
   vis->mobjflags = thing->flags;
+  vis->ps_pid = thing->ps_pid;
+  vis->ps_draw = thing->ps_pid && thing->ps_draw;
+  memcpy(vis->ps_label, thing->ps_label, sizeof vis->ps_label);
   vis->mobjflags2 = thing->flags2;
   vis->mobjflags_extra = thing->flags_extra;
   vis->scale = xscale;
@@ -911,6 +926,7 @@ void R_DrawPSprite(pspdef_t *psp, int lightlevel_override)
 
   // store information in a vissprite
   vis = &avis;
+  vis->ps_draw = false;  // psdoom-plus: no label on the weapon

diff --git a/src/p_inter.c b/src/p_inter.c
index f7d097f..e3a1cd7 100644
--- a/src/p_inter.c
+++ b/src/p_inter.c
@@ -18,6 +18,7 @@
 //-----------------------------------------------------------------------------
 
 #include "p_inter.h"
+#include "p_psdoom.h"
 
 #include "am_map.h"
 #include "deh_strings.h"
@@ -654,6 +655,8 @@ static void P_KillMobj(mobj_t *source, mobj_t *inflictor, mobj_t *target, method
 
   target->flags &= ~(MF_SHOOTABLE|MF_FLOAT|MF_SKULLFLY);
 
+  PS_Killed(source, target);  // psdoom-plus: kill the process
+
   if (target->type != MT_SKULL)
     target->flags &= ~MF_NOGRAVITY;
 
@@ -757,6 +760,10 @@ static void P_KillMobj(mobj_t *source, mobj_t *inflictor, mobj_t *target, method
   if (target->tics < 1)
     target->tics = 1;
 
+  // psdoom-plus: a vanished process leaves nothing behind
+  if (PS_NoDrop(target))
+    return;
+
   // Drop stuff.
   // This determines the kind of object spawned
   // during the death frame of a thing.
@@ -771,6 +778,12 @@ static void P_KillMobj(mobj_t *source, mobj_t *inflictor, mobj_t *target, method
   mo->flags |= MF_DROPPED;    // special versions of items
 }
 
+// psdoom-plus: the shared glue's two-argument P_KillMobj
+void PS_P_KillMobj(mobj_t *source, mobj_t *target)
+{
+  P_KillMobj(source, NULL, target, MOD_None);
+}
+
 //
 // P_DamageMobj
 // Damages both enemies and players
@@ -803,6 +816,10 @@ void P_DamageMobjBy(mobj_t *target,mobj_t *inflictor, mobj_t *source, int damage
   if (target->health <= 0)
     return;
 
+  // psdoom-plus: pid monsters only take damage from players (psDooM)
+  if (!PS_DamageAllowed(target, inflictor, source))
+    return;
+
   if (target->flags & MF_SKULLFLY)
     target->momx = target->momy = target->momz = 0;
 
@@ -902,6 +919,7 @@ void P_DamageMobjBy(mobj_t *target,mobj_t *inflictor, mobj_t *source, int damage
 
   // do the damage
   target->health -= damage;
+  PS_Damaged(target);  // psdoom-plus: renice
 
   // BUDDHA cheat
   if (player && player->cheats & CF_BUDDHA &&

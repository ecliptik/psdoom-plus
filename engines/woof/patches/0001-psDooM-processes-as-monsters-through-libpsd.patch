 #include "doomstat.h"
@@ -402,6 +403,10 @@ void R_DrawMaskedColumn(column_t *column)
       // killough 3/2/98, 3/27/98: Failsafe against overflow/crash:
       if (dc_yl <= dc_yh && dc_yh < viewheight)
         {
+          // psdoom-plus: where the label goes (top of what was drawn)
+          if (!ps_col_drawn || dc_yl < ps_col_top)

@@ -846,6 +847,8 @@ static void P_KillMobj(mobj_t *source, mobj_t *target)
 
   target->flags &= ~(MF_SHOOTABLE|MF_FLOAT|MF_SKULLFLY);
 
+  PS_Killed(source, target);  // psdoom-plus: kill the process
+
   if (target->type != MT_SKULL)
     target->flags &= ~MF_NOGRAVITY;
 
@@ -1186,6 +1189,10 @@ static void P_KillMobj(mobj_t *source, mobj_t *target)
     return;
   }
 
+  // psdoom-plus: a vanished process leaves nothing behind
+  if (PS_NoDrop(target))
+    return;
+
   // Drop stuff.
   // This determines the kind of object spawned
   // during the death frame of a thing.
@@ -1205,6 +1212,12 @@ static void P_KillMobj(mobj_t *source, mobj_t *target)
   }
 }
 
+// psdoom-plus: P_KillMobj for the shared glue
+void PS_P_KillMobj(mobj_t *source, mobj_t *target)
+{
+  P_KillMobj(source, target);
+}
+
 //
 // P_DamageMobj
 // Damages both enemies and players
@@ -1285,6 +1298,10 @@ void P_DamageMobj(mobj_t *target,mobj_t *inflictor, mobj_t *source, int damage)
     }
   }
 
+  // psdoom-plus: pid monsters only take damage from players (psDooM)
+  if (!PS_DamageAllowed(target, inflictor, source))
+    return;
+
   if (target->flags & MF_SKULLFLY)
   {
     if (heretic && target->type == HERETIC_MT_MINOTAUR) return;
@@ -1646,6 +1663,7 @@ void P_DamageMobj(mobj_t *target,mobj_t *inflictor, mobj_t *source, int damage)
 
   // do the damage
   target->health -= damage;
+  PS_Damaged(target);  // psdoom-plus: renice
   if (target->health <= 0)
   {
     if (heretic) {

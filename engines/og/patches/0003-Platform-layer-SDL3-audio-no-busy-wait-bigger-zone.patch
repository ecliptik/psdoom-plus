+//#define SNDSERV  1
 //#define SNDINTR  1
 
 
diff --git a/linuxdoom-1.10/i_sound.c b/linuxdoom-1.10/i_sound.c
index a327bfa..f6c0a1e 100644
--- a/linuxdoom-1.10/i_sound.c
+++ b/linuxdoom-1.10/i_sound.c
@@ -33,16 +33,11 @@ rcsid[] = "$Id: i_unix.c,v 1.5 1997/02/03 22:45:10 b1 Exp $";
 #include <sys/time.h>
 #include <sys/types.h>
 
-#ifndef LINUX
-#include <sys/filio.h>
-#endif
-
 #include <fcntl.h>
 #include <unistd.h>
-#include <sys/ioctl.h>
 
-// Linux voxware output.
-#include <linux/soundcard.h>
+// psdoom-plus: output goes through the platform layer (SDL3), not /dev/dsp
+#include "i_platform.h"
 
 // Timer stuff. Experimental.
 #include <time.h>
@@ -103,7 +98,7 @@ static int flag = 0;
 int 		lengths[NUMSFX];
 
 // The actual output device.
-int	audio_fd;
+int	audio_fd = -1;
 
 // The global mixing buffer.
 // Basically, samples from all active internal channels
@@ -156,23 +151,7 @@ int*		channelrightvol_lookup[NUM_CHANNELS];
 //
 // Safe ioctl, convenience.
 //
-void
-myioctl
-( int	fd,
-  int	command,
-  int*	arg )
-{   
-    int		rc;
-    extern int	errno;
-    
-    rc = ioctl(fd, command, arg);  
-    if (rc < 0)
-    {
-	fprintf(stderr, "ioctl(dsp,%d,arg) failed\n", command);
-	fprintf(stderr, "errno=%d\n", errno);
-	exit(-1);
-    }
-}
+// (myioctl removed: no OSS ioctls with the platform audio layer)
 
 
 
@@ -536,7 +515,7 @@ int I_SoundIsPlaying(int handle)
 //
 // This function currently supports only 16bit.
 //
-void I_UpdateSound( void )
+static void I_MixSound( void )
 {
 #ifdef SNDINTR
   // Debug. Count buffer misses with interrupt.
@@ -662,11 +641,24 @@ void I_UpdateSound( void )
 // Mixing now done synchronous, and
 //  only output be done asynchronous?
 //
+void I_UpdateSound( void )
+{
+  // Mixed on demand in I_SubmitSound, paced by the audio device.
+}
+
 void
 I_SubmitSound(void)
 {
-  // Write it to DSP device.
-  write(audio_fd, mixbuffer, SAMPLECOUNT*BUFMUL);
+  // Keep about two mix buffers queued; never run ahead of the device
+  // (the old blocking write() to /dev/dsp throttled the whole game).
+  int guard = 8;
+
+  while (audio_fd >= 0 && guard-- > 0
+         && I_AudioQueued() < 2*SAMPLECOUNT*BUFMUL)
+  {
+    I_MixSound();
+    I_AudioWrite(mixbuffer, SAMPLECOUNT*BUFMUL);
+  }
 }
 
 
@@ -721,8 +713,9 @@ void I_ShutdownSound(void)
   I_SoundDelTimer();
 #endif
   
-  // Cleaning up -releasing the DSP device.
-  close ( audio_fd );
+  // Cleaning up -releasing the audio device.
+  I_AudioClose();
+  audio_fd = -1;
 #endif
 
   // Done.
@@ -767,28 +760,8 @@ I_InitSound()
   // Secure and configure sound device first.
   fprintf( stderr, "I_InitSound: ");
   
-  audio_fd = open("/dev/dsp", O_WRONLY);
-  if (audio_fd<0)
-    fprintf(stderr, "Could not open /dev/dsp\n");
-  
-                     
-  i = 11 | (2<<16);                                           
-  myioctl(audio_fd, SNDCTL_DSP_SETFRAGMENT, &i);
-  myioctl(audio_fd, SNDCTL_DSP_RESET, 0);
-  
-  i=SAMPLERATE;
-  
-  myioctl(audio_fd, SNDCTL_DSP_SPEED, &i);
-  
-  i=1;
-  myioctl(audio_fd, SNDCTL_DSP_STEREO, &i);
-  
-  myioctl(audio_fd, SNDCTL_DSP_GETFMTS, &i);
-  
-  if (i&=AFMT_S16_LE)    
-    myioctl(audio_fd, SNDCTL_DSP_SETFMT, &i);
-  else
-    fprintf(stderr, "Could not play signed 16 data\n");
+  // 11025 Hz, signed 16-bit stereo, as the OSS code asked for
+  audio_fd = M_CheckParm("-nosound") ? -1 : I_AudioOpen(SAMPLERATE);
 
   fprintf(stderr, " configured audio device\n" );
 
@@ -808,7 +781,7 @@ I_InitSound()
     {
       // Previously loaded already?
       S_sfx[i].data = S_sfx[i].link->data;
-      lengths[i] = lengths[(S_sfx[i].link - S_sfx)/sizeof(sfxinfo_t)];
+      lengths[i] = lengths[S_sfx[i].link - S_sfx];
     }
   }
 

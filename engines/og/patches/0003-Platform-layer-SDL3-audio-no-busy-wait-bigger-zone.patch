 #include "i_video.h"
 #include "i_net.h"
 #include "g_game.h"
@@ -730,6 +731,7 @@ void TryRunTics (void)
 	    M_Ticker ();
 	    return;
 	} 
+	I_Yield ();	// psdoom-plus: don't spin at 100% CPU
     }
     
     // run the count * ticdup dics

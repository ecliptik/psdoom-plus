diff --git a/linuxdoom-1.10/doomtype.h b/linuxdoom-1.10/doomtype.h
index e89a7a6..1e77622 100644
--- a/linuxdoom-1.10/doomtype.h
+++ b/linuxdoom-1.10/doomtype.h
@@ -25,11 +25,21 @@
 #define __DOOMTYPE__
 
 
+// 64-bit and modern-libc portability (psdoom-plus)
+#include <stdint.h>
+#include <stddef.h>
+#if defined(__GNUC__) && !defined(alloca)
+#define alloca __builtin_alloca
+#endif
+
 #ifndef __BYTEBOOL__
 #define __BYTEBOOL__
 // Fixed to use builtin bool type with C++.
 #ifdef __cplusplus
 typedef bool boolean;
+#elif defined(__bool_true_false_are_defined) || defined(true)
+// stdbool.h is already in (e.g. via SDL): keep an int-sized boolean.
+typedef int boolean;
 #else
 typedef enum {false, true} boolean;
 #endif
@@ -38,7 +48,7 @@ typedef unsigned char byte;
 
 
 // Predefined with some OS.
-#ifdef LINUX
+#if 0 // <values.h> is gone from modern libcs
 #include <values.h>
 #else
 #define MAXCHAR		((char)0x7f)

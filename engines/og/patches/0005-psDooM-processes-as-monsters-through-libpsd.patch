 linuxdoom-1.10/g_game.c   |  4 ++++
 linuxdoom-1.10/p_inter.c  | 12 ++++++++++++
 linuxdoom-1.10/p_mobj.c   |  7 +++++--
 linuxdoom-1.10/p_mobj.h   |  7 +++++++
 linuxdoom-1.10/p_saveg.c  |  4 ++++
 linuxdoom-1.10/p_setup.c  |  4 ++++
 linuxdoom-1.10/p_tick.c   |  2 ++
 linuxdoom-1.10/r_defs.h   |  5 +++++
 linuxdoom-1.10/r_things.c | 16 ++++++++++++++++
 10 files changed, 62 insertions(+), 2 deletions(-)


     wadfiles[numwadfiles] = newfile;
 }
 
+
+//
+// psdoom-plus: XDG paths, -iwad and Freedoom
+//
+
+// mkdir -p for the directory part of path
+static void D_MakeParents (char* path)
+{
+    char*	p;
+
+    for (p = path + 1; *p; p++)
+    {
+	if (*p != '/')
+	    continue;
+	*p = 0;
+	mkdir (path, 0700);
+	*p = '/';
+    }
+}
+
+// $XDG_<var> or $HOME/<fallback>, then "/psdoom/<leaf>"
+static void D_XdgPath (char* out, size_t len, char* var, char* fallback, char* leaf)
+{
+    char*	base = getenv (var);
+    char*	home = getenv ("HOME");
+
+    if (base && base[0] == '/')
+	snprintf (out, len, "%s/psdoom/%s", base, leaf);
+    else if (home)
+	snprintf (out, len, "%s/%s/psdoom/%s", home, fallback, leaf);
+    else
+	snprintf (out, len, "./%s", leaf);
+    D_MakeParents (out);
+}
+
+// The game mode of an IWAD, from its own lump directory.
+static GameMode_t D_IwadMode (char* path)
+{
+    FILE*	f = fopen (path, "rb");
+    char	hdr[12], entry[16];
+    int		numlumps, dirofs, i;
+    boolean	map01 = false, e2m1 = false, e4m1 = false;
+
+    if (!f)
+	I_Error ("Cannot open IWAD %s", path);
+    if (fread (hdr, 1, 12, f) != 12 || memcmp (hdr, "IWAD", 4))
+	I_Error ("%s is not an IWAD", path);
+    numlumps = LONG (*(int*)(hdr+4));
+    dirofs = LONG (*(int*)(hdr+8));
+    fseek (f, dirofs, SEEK_SET);
+    for (i = 0; i < numlumps && fread (entry, 1, 16, f) == 16; i++)
+    {
+	if (!strncmp (entry+8, "MAP01", 8)) map01 = true;
+	if (!strncmp (entry+8, "E2M1", 8)) e2m1 = true;
+	if (!strncmp (entry+8, "E4M1", 8)) e4m1 = true;
+    }
+    fclose (f);
+    if (map01) return commercial;
+    if (e4m1)  return retail;
+    if (e2m1)  return registered;
+    return shareware;
+}
+
+// Freedoom, in the usual install locations, after id's own names.
+static boolean D_FindFreedoom (char* waddir)
+{
+    char*	dirs[] = { waddir, "/usr/share/games/doom", "/usr/local/share/games/doom",
+			   "/usr/local/share/doom", "/usr/pkg/share/doom",
+			   "/boot/system/data/doom", NULL };
+    char*	names[] = { "freedoom2.wad", "freedoom1.wad", NULL };
+    char	path[1024];
+    int		d, n;
+
+    for (d = 0; dirs[d]; d++)
+	for (n = 0; names[n]; n++)
+	{
+	    snprintf (path, sizeof path, "%s/%s", dirs[d], names[n]);
+	    if (!access (path, R_OK))
+	    {
+		gamemode = D_IwadMode (path);
+		printf ("Using Freedoom: %s\n", path);
+		D_AddFile (strdup (path));
+		return true;
+	    }
+	}
+    return false;
+}
+
 //
 // IdentifyVersion
 // Checks availability of IWAD files by name,
@@ -611,9 +702,21 @@ void IdentifyVersion (void)
     home = getenv("HOME");
     if (!home)
       I_Error("Please set $HOME to your home directory");
-    sprintf(basedefault, "%s/.doomrc", home);
+    // psdoom-plus: XDG config and data directories instead of ~/.doomrc
+    D_XdgPath (basedefault, sizeof basedefault, "XDG_CONFIG_HOME", ".config", "og.cfg");
+    D_XdgPath (savedir, sizeof savedir, "XDG_DATA_HOME", ".local/share", "og/");
 #endif
 
+    {
+	int p = M_CheckParm ("-iwad");
+	if (p && p < myargc-1)
+	{
+	    gamemode = D_IwadMode (myargv[p+1]);
+	    D_AddFile (myargv[p+1]);
+	    return;
+	}
+    }
+
     if (M_CheckParm ("-shdev"))
     {
 	gamemode = shareware;
@@ -708,6 +811,10 @@ void IdentifyVersion (void)
       return;
     }
 
+#ifdef NORMALUNIX
+    if (D_FindFreedoom (doomwaddir))
+	return;
+#endif
     printf("Game mode indeterminate.\n");
     gamemode = indetermined;
 
@@ -1153,7 +1260,7 @@ void D_DoomMain (void)
 	if (M_CheckParm("-cdrom"))
 	    sprintf(file, "c:\\doomdata\\"SAVEGAMENAME"%c.dsg",myargv[p+1][0]);
 	else
-	    sprintf(file, SAVEGAMENAME"%c.dsg",myargv[p+1][0]);
+	    sprintf(file, "%s"SAVEGAMENAME"%c.dsg",savedir,myargv[p+1][0]);
 	G_LoadGame (file);
     }
 	

-    if (maptex2)
-	Z_Free (maptex2);
+    Z_Free (patchlookup);
+    for (i = 0; i < numtexlumps; i++)
+	Z_ChangeTag (texlumps[i].maptex, PU_CACHE);
     
     // Precalculate whatever possible.	
     for (i=0 ; i<numtextures ; i++)

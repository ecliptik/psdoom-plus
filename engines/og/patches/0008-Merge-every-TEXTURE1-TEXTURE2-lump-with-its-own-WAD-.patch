From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Micheal Waltz <micheal@ecliptik.com>
Date: Wed, 4 Nov 2026 12:37:37 -0800
Subject: [PATCH 8/8] Merge every TEXTURE1/TEXTURE2 lump with its own WAD's
 PNAMES

After Crispy Doom: a PWAD that brings a texture list of its own (psDooM's
levels do, for one texture) adds to the IWAD's instead of replacing it.
With Freedoom 2, psdoom2.wad's Doom II-based list left the maps after
MAP01 without textures they use (LITE4, LITE96): a crash on MAP02. The
newest lumps come first, so PWAD definitions win name lookups and
texture 0 stays the first of the newest TEXTURE1.
---
 linuxdoom-1.10/r_data.c | 142 +++++++++++++++++++++++++++-------------
 1 file changed, 97 insertions(+), 45 deletions(-)

diff --git a/linuxdoom-1.10/r_data.c b/linuxdoom-1.10/r_data.c
index e0b6655..1710b48 100644
--- a/linuxdoom-1.10/r_data.c
+++ b/linuxdoom-1.10/r_data.c
@@ -43,6 +43,7 @@ rcsid[] = "$Id: r_data.c,v 1.4 1997/02/03 16:47:55 b1 Exp $";
 
 #ifdef LINUX
 #include  <alloca.h>
+#include  <strings.h>	// psdoom-plus: strncasecmp
 #endif
 
 
@@ -408,6 +409,25 @@ R_GetColumn
 // Initializes the texture list
 //  with the textures from the world map.
 //
+//
+// psdoom-plus: every TEXTURE1/TEXTURE2 lump, each read with the PNAMES of its
+// own WAD (after Crispy Doom), so a PWAD that brings a texture list of its
+// own (psDooM's levels do, for one texture) adds to the IWAD's instead of
+// replacing it: with Freedoom, the maps after psDooM's MAP01 need textures
+// that Doom II's list lacks. The newest lumps come first, so their textures
+// win name lookups, and texture 0 is still the first of the newest TEXTURE1.
+//
+#define PS_MAXTEXLUMPS 64
+
+typedef struct
+{
+    int		lump;
+    int*	maptex;
+    int		maxoff;
+    int		sumtextures;	// textures in this lump and the ones before
+    int		pnamesbase;	// its WAD's PNAMES in patchlookup[]
+} ps_texlump_t;
+
 void R_InitTextures (void)
 {
     maptexture_t*	mtexture;
@@ -417,14 +437,11 @@ void R_InitTextures (void)
 
     int			i;
     int			j;
+    int			k;
 
     int*		maptex;
-    int*		maptex2;
-    int*		maptex1;
     
     char		name[9];
-    char*		names;
-    char*		name_p;
     
     int*		patchlookup;
     
@@ -432,9 +449,6 @@ void R_InitTextures (void)
     int			nummappatches;
     int			offset;
     int			maxoff;
-    int			maxoff2;
-    int			numtextures1;
-    int			numtextures2;
 
     int*		directory;
     
@@ -442,42 +456,77 @@ void R_InitTextures (void)
     int			temp2;
     int			temp3;
 
-    
-    // Load the patch names from pnames.lmp.
-    name[8] = 0;	
-    names = W_CacheLumpName ("PNAMES", PU_STATIC);
-    nummappatches = LONG ( *((int *)names) );
-    name_p = names+4;
-    patchlookup = alloca (nummappatches*sizeof(*patchlookup));
-    
-    for (i=0 ; i<nummappatches ; i++)
+    int			pnames[PS_MAXTEXLUMPS];
+    int			pnamesbase[PS_MAXTEXLUMPS];
+    int			numpnames = 0;
+    ps_texlump_t	texlumps[PS_MAXTEXLUMPS];
+    int			numtexlumps = 0;
+    ps_texlump_t*	tl;
+
+    // Every PNAMES lump, newest first, as one patch lookup table.
+    nummappatches = 0;
+    for (i = numlumps - 1; i >= 0 && numpnames < PS_MAXTEXLUMPS; i--)
     {
-	strncpy (name,name_p+i*8, 8);
-	patchlookup[i] = W_CheckNumForName (name);
+	if (strncasecmp (lumpinfo[i].name, "PNAMES", 8))
+	    continue;
+	pnames[numpnames] = i;
+	pnamesbase[numpnames] = nummappatches;
+	nummappatches += LONG (*(int *) W_CacheLumpNum (i, PU_STATIC));
+	numpnames++;
     }
-    Z_Free (names);
-    
-    // Load the map texture definitions from textures.lmp.
-    // The data is contained in one or two lumps,
-    //  TEXTURE1 for shareware, plus TEXTURE2 for commercial.
-    maptex = maptex1 = W_CacheLumpName ("TEXTURE1", PU_STATIC);
-    numtextures1 = LONG(*maptex);
-    maxoff = W_LumpLength (W_GetNumForName ("TEXTURE1"));
-    directory = maptex+1;
-	
-    if (W_CheckNumForName ("TEXTURE2") != -1)
+    if (numpnames == 0)
+	I_Error ("R_InitTextures: no PNAMES lump");
+    name[8] = 0;
+    patchlookup = Z_Malloc (nummappatches*sizeof(*patchlookup), PU_STATIC, 0);
+    for (i = 0, k = 0; i < numpnames; i++)
     {
-	maptex2 = W_CacheLumpName ("TEXTURE2", PU_STATIC);
-	numtextures2 = LONG(*maptex2);
-	maxoff2 = W_LumpLength (W_GetNumForName ("TEXTURE2"));
+	int*	names = W_CacheLumpNum (pnames[i], PU_STATIC);
+	char*	name_p = (char *) names + 4;
+
+	for (j = 0; j < LONG (*names); j++)
+	{
+	    strncpy (name, name_p + j*8, 8);
+	    patchlookup[k++] = W_CheckNumForName (name);
+	}
+	Z_ChangeTag (names, PU_CACHE);
     }
-    else
+
+    // The texture lumps: the newest TEXTURE1 (and TEXTURE2) first, as
+    // vanilla would use them, then every other one, newest first.
+    texlumps[numtexlumps++].lump = W_GetNumForName ("TEXTURE1");
+    if ((i = W_CheckNumForName ("TEXTURE2")) != -1)
+	texlumps[numtexlumps++].lump = i;
+    for (i = numlumps - 1; i >= 0 && numtexlumps < PS_MAXTEXLUMPS; i--)
     {
-	maptex2 = NULL;
-	numtextures2 = 0;
-	maxoff2 = 0;
+	if (strncasecmp (lumpinfo[i].name, "TEXTURE1", 8)
+	    && strncasecmp (lumpinfo[i].name, "TEXTURE2", 8))
+	    continue;
+	for (j = 0; j < numtexlumps && texlumps[j].lump != i; j++)
+	    ;
+	if (j == numtexlumps)
+	    texlumps[numtexlumps++].lump = i;
     }
-    numtextures = numtextures1 + numtextures2;
+    numtextures = 0;
+    for (i = 0; i < numtexlumps; i++)
+    {
+	tl = &texlumps[i];
+	tl->maptex = W_CacheLumpNum (tl->lump, PU_STATIC);
+	tl->maxoff = W_LumpLength (tl->lump);
+	numtextures += LONG (*tl->maptex);
+	tl->sumtextures = numtextures;
+	// the PNAMES of the same WAD; without one, vanilla's (the newest)
+	tl->pnamesbase = 0;
+	for (j = 0; j < numpnames; j++)
+	    if (lumpinfo[pnames[j]].handle == lumpinfo[tl->lump].handle)
+	    {
+		tl->pnamesbase = pnamesbase[j];
+		break;
+	    }
+    }
+    tl = texlumps;
+    maptex = tl->maptex;
+    maxoff = tl->maxoff;
+    directory = maptex+1;
 	
     textures = Z_Malloc (numtextures*sizeof(*textures), PU_STATIC, 0);
     texturecolumnlump = Z_Malloc (numtextures*sizeof(*texturecolumnlump), PU_STATIC, 0);
@@ -506,11 +555,12 @@ void R_InitTextures (void)
 	if (!(i&63))
 	    printf (".");
 
-	if (i == numtextures1)
+	while (i == tl->sumtextures)
 	{
-	    // Start looking in second texture file.
-	    maptex = maptex2;
-	    maxoff = maxoff2;
+	    // Start looking in the next texture lump.
+	    tl++;
+	    maptex = tl->maptex;
+	    maxoff = tl->maxoff;
 	    directory = maptex+1;
 	}
 		
@@ -536,9 +586,11 @@ void R_InitTextures (void)
 
 	for (j=0 ; j<texture->patchcount ; j++, mpatch++, patch++)
 	{
+	    int p = SHORT(mpatch->patch) + tl->pnamesbase;
+
 	    patch->originx = SHORT(mpatch->originx);
 	    patch->originy = SHORT(mpatch->originy);
-	    patch->patch = patchlookup[SHORT(mpatch->patch)];
+	    patch->patch = p >= 0 && p < nummappatches ? patchlookup[p] : -1;
 	    if (patch->patch == -1)
 	    {
 		I_Error ("R_InitTextures: Missing patch in texture %s",
@@ -558,9 +610,9 @@ void R_InitTextures (void)
 	totalwidth += texture->width;
     }
 

diff --git a/src/doom/p_inter.c b/src/doom/p_inter.c
index 645f8203..3abe1901 100644
--- a/src/doom/p_inter.c
+++ b/src/doom/p_inter.c
@@ -38,6 +38,7 @@
 #include "s_sound.h"
 
 #include "p_inter.h"
+#include "p_psdoom.h"
 
 
 #define BONUSADD	6
@@ -739,6 +740,8 @@ P_KillMobj
 	
     target->flags &= ~(MF_SHOOTABLE|MF_FLOAT|MF_SKULLFLY);
 
+    PS_Killed (source, target);	// psdoom-plus: kill the process
+
     if (target->type != MT_SKULL)
 	target->flags &= ~MF_NOGRAVITY;
 
@@ -834,6 +837,10 @@ P_KillMobj
         return;
     }
 
+    // psdoom-plus: a vanished process leaves nothing behind
+    if (PS_NoDrop (target))
+	return;
+
     // Drop stuff.
     // This determines the kind of object spawned
     // during the death frame of a thing.
@@ -881,6 +888,10 @@ P_DamageMobj
     if (target->health <= 0)
 	return;
 
+    // psdoom-plus: pid monsters only take damage from players (psDooM)
+    if (!PS_DamageAllowed (target, inflictor, source))
+	return;
+
     if ( target->flags & MF_SKULLFLY )
     {
 	target->momx = target->momy = target->momz = 0;
@@ -980,6 +991,7 @@ P_DamageMobj
     
     // do the damage	
     target->health -= damage;	
+    PS_Damaged (target);	// psdoom-plus: renice
     if (target->health <= 0)
     {
 	P_KillMobj (source, target);

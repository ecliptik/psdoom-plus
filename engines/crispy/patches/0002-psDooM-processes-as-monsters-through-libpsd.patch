     // we're playing and which version of Vanilla Doom we need to emulate.
     D_IdentifyVersion();
+    PS_AddCustomLevel ();	// psdoom-plus: psdoom1/2.wad
     InitGameVersion();
 
     // Check which IWAD variant we are using.
@@ -2166,6 +2168,7 @@ void D_DoomMain (void)
     I_InitJoystick();
     I_InitSound(doom);
     I_InitMusic();
+    PS_Init ();		// psdoom-plus: open libpsd
 
     // [crispy] check for SSG resources
     crispy->havessg =

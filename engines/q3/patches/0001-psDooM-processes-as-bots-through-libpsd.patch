  	Q_strncpyz( client->pers.guid, value, sizeof( client->pers.guid ) );
@@ -2114,6 +2117,7 @@ void ClientDisconnect( int clientNum ) {
 	// cleanup if we are kicking a bot that
 	// hasn't spawned yet

 	memset( client, 0, sizeof(*client) );
 
 	trap_GetUserinfo( clientNum, userinfo, sizeof( userinfo ) );
+	if ( isBot && !firstTime && PSQ3_StaleBot( userinfo ) ) {
+		return "process bot from an earlier map";
